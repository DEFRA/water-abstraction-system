NODE_ENV=development

# Shut up dot env!
DOTENV_CONFIG_QUIET=true

# Address Facade config
EA_ADDRESS_FACADE_URL=http://localhost:8009

# Airbrake config
AIRBRAKE_HOST=https://my-errbit-instance.com
AIRBRAKE_KEY=longvaluefullofnumbersandlettersinlowercase
ENVIRONMENT=dev

# Billing config
BILLING_ANNUAL_BATCH_SIZE=5
BILLING_WAIT_FOR_STATUS_PAUSE_IN_MS=1000

# Charging Module config
CHA_REQUEST_TIMEOUT=20000
CHARGING_MODULE_TOKEN_PASSWORD=longvaluefullofnumbersandlettersinlowercase
CHARGING_MODULE_TOKEN_URL=https://myinstance.amazoncognito.com
CHARGING_MODULE_TOKEN_USERNAME=valuefullofnumbersandlettersinlowercase
CHARGING_MODULE_URL=http://localhost:8020

# Companies House config
COMPANIES_HOUSE_API_KEY=longvaluefullofnumbersandlettersinlowercase

# Database config
DEFAULT_USER_PASSWORD=P@55word
POSTGRES_DB=wabs
POSTGRES_DB_TEST=wabs_system_test
POSTGRES_HOST=db
POSTGRES_PASSWORD=password12345
POSTGRES_PORT=5432
POSTGRES_USER=myuser

# Feature flags config
ENABLE_PARTY_MODE=true
ENABLE_WIDGETS=true

# Gotenberg config
GOTENBERG_DELAY=2000
GOTENBERG_TIMEOUT=20000
GOTENBERG_URL=http://localhost:8040

# Hapi config
PORT=3000

# Legacy config
EXTERNAL_UI_URL=http://localhost:8000
IMPORT_URL=http://localhost:8007
INTERNAL_UI_URL=http://localhost:8008
LEGACY_AUTH_TOKEN=longvalueofnumbersandletters.inbothcases.splitin3by2periods
PERMIT_REPOSITORY_URL=http://localhost:8004
RETURNS_URL=http://localhost:8006
SERVICE_BACKGROUND_URL=http://localhost:8012
SERVICE_FOREGROUND_URL=http://localhost:8001
TACTICAL_CRM_URL=http://localhost:8002
TACTICAL_IDM_URL=http://localhost:8003

# Licences config
LICENCE_END_DATES_BATCH_SIZE=10

# Log config
LOG_ASSET_REQUESTS=false
LOG_IN_TEST=false

# Notify config
ALERT_EMAIL_ADDRESSES=admin-internal@wrls.gov.uk
GOV_UK_NOTIFY_API_KEY=my_test_key-longvaluefullofnumbersandlettersinlowercase
GOV_UK_NOTIFY_AUTH_TOKEN=longvaluefullofnumbersandlettersinlowercase
GOV_UK_NOTIFY_DAYS_OF_RETENTION=90
GOV_UK_NOTIFY_DELAY=30
GOV_UK_NOTIFY_RATE_LIMIT_PAUSE=90000
GOV_UK_NOTIFY_REPLY_TO=notify@test.gov.uk
GOV_UK_NOTIFY_TIMEOUT=10000
GOV_UK_NOTIFY_URL=https://api.notifications.service.gov.uk
NOTIFICATIONS_BATCH_SIZE=10000

# Redis config
REDIS_DISABLE_TLS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ReSP API config
RESP_CLIENT_ID=clientId
RESP_CLIENT_SECRET=clientSecret
RESP_SCOPE=api://applicationId/.default
RESP_TENANT_ID=tenantId
RESP_TOKEN_URL=https://login.microsoftonline.com
RESP_URL=https://respUrl.azure.cloud

# Server config
EXTERNAL_DOMAIN=http://localhost:8000
http_proxy=http://myproxy:8080
INTERNAL_DOMAIN=http://localhost:8008
REQUEST_TIMEOUT=5000

# S3 config
AWS_ACCESS_KEY_ID=uploadaccesskey
AWS_MAINTENANCE_BUCKET=upload-bucket-gov-uk
AWS_REGION=eu-west-1
AWS_SECRET_ACCESS_KEY=uploadsecretkey

# Yar config
COOKIE_SECRET=longvaluefullofnumbersandlettersinlowercase
SESSION_NAME=wrls-internal
