{% extends 'layout.njk' %}

{% from 'govuk/components/button/macro.njk' import govukButton %}
{% from 'govuk/components/table/macro.njk' import govukTable %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}

{% from 'macros/licence-monitoring-station-restrictions-table.njk' import licenceMonitoringStationRestrictionsTable %}

{% block pageContent %}
  {% set filtersForm %}
    <h2 class="govuk-heading-m govuk-!-margin-bottom-3">Filter by</h2>
    <form method="post" action="{{ filter.actionLink }}">
      <input type="hidden" name="wrlsCrumb" value="{{ wrlsCrumb }}"/>

      {{ govukCheckboxes({
        name: "periods",
        classes: "govuk-checkboxes--small",
        fieldset: {
          legend: {
            text: "Abstraction periods",
            isPageHeading: false,
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: filter.periods
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({
          preventDoubleClick: true,
          text: "Apply filters"
        }) }}

        {{ govukButton({
          classes: "govuk-button--secondary",
          name: "clearFilters",
          value: "reset",
          preventDoubleClick: true,
          text: "Clear filters"
        }) }}
      </div>
    </form>
  {% endset %}

  {{ govukDetails({
    classes: "govuk-!-margin-bottom-2",
    html: filtersForm,
    open: filter.openFilter,
    summaryText: "Filters"
  })}}

  {{ licenceMonitoringStationRestrictionsTable(restrictions, restrictionHeading) }}

  <form method="post">
    <input type="hidden" name="wrlsCrumb" value="{{ wrlsCrumb }}"/>

    <div class="govuk-button-group">
      {{ govukButton({ text: "Continue", preventDoubleClick: true }) }}

      {{ govukButton({
        text: "Cancel",
        classes: "govuk-button--secondary",
        href: cancelLink,
        preventDoubleClick: true
      }) }}
    </div>
  </form>
{% endblock %}
